# Point LiteLLM at the local Grid AI load balancer.
# The balancer (gridAIloaddistributionserver) injects the real Bearer token,
# so this key is just a non-empty placeholder.
OPENAI_API_BASE=http://localhost:3456/v1
OPENAI_API_KEY=placeholder-proxy-injects-real-key

# Model names visible at GET /v1/models. Free internal models only —
# external paid models (Claude, Gemini) are budget-blocked on this account.
GEPA_TASK_LM=openai/nemotron
GEPA_REFLECTION_LM=openai/deepseek

# How much budget to spend in a single optimization run.
GEPA_MAX_METRIC_CALLS=60
